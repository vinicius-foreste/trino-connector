# Example .env — NL2SQL com RAG + Toqan + Trino
# Copie para .env e preencha os valores reais.

# ─── Toqan (LLM Gateway) ──────────────────────────────────────
TOQAN_API_KEY=sk_SUA_CHAVE_AQUI
TOQAN_BASE_URL=https://api.toqan.ai/api
TOQAN_AGENT_NAME=GeneralAssistant
TOQAN_VERIFY_SSL=false
TOQAN_POLL_INTERVAL=3
TOQAN_MAX_ATTEMPTS=20

# ─── Trino ─────────────────────────────────────────────────────
TRINO_HOST=trino-gateway.dataeng.bigdata.olxbr.io
TRINO_PORT=443
TRINO_USER=seu.usuario
TRINO_PASSWORD=sua_senha
TRINO_CATALOG=hive
TRINO_SCHEMA=ods

# ─── ChromaDB / RAG ───────────────────────────────────────────
CHROMA_PERSIST_DIR=.chroma_db
CHROMA_COLLECTION=trino_catalog
RAG_TOP_K=10

# ─── Logs ──────────────────────────────────────────────────────
AUDIT_LOG_FILE=query_audit_log.json
